library(tidyverse)
library(readxl)
library(caret)
library(pROC)
library(yardstick)
library(rms)
library(rmsMD)
# Import OrQA Scores
OrQA_Scores <- read_csv("data/OrQA_Scores_v11x.csv", na = "-", show_col_types = FALSE)
# Add USC Study ID and order
OrQA_Scores <- OrQA_Scores %>%
mutate(`USC Study ID` = as.integer(str_extract(filename, "^[0-9]+"))) %>%
arrange(`USC Study ID`)
# Summarise to overall scores
OrQA_overall_scores <- OrQA_Scores %>%
group_by(`USC Study ID`) %>%
summarise(
OrQA_Score    = mean(OrQA_Score,    na.rm = TRUE),
lower_95ci    = mean(lower_95ci,    na.rm = TRUE),
higher_95ci   = mean(higher_95ci,   na.rm = TRUE)
)
# Transform OrQA_Scores to range from 0 to 4
# Define original range
min_val <- 0.5
max_val <- 3.5
# Rescale scores to 0–4
OrQA_overall_scores <- OrQA_overall_scores %>%
mutate(
OrQA_Score  = (OrQA_Score  - min_val) / (max_val - min_val) * 4,
lower_95ci  = (lower_95ci  - min_val) / (max_val - min_val) * 4,
higher_95ci = (higher_95ci - min_val) / (max_val - min_val) * 4
)
# Import USC Liver data
USC_Liver_data <- read_csv("data/USC_Liver_data.csv",show_col_types = FALSE)
# Clean up USC Liver data
USC_Liver_data <- USC_Liver_data %>%
mutate(`USC Study ID` = as.integer(`USC Study ID`)) %>%
rename(
Donor_type = `DCD (y / n)`,
Right_lobe_biopsy_type = `R (1=core, 0=wedge)`,
Left_lobe_biopsy_type = `L (1=core, 0=wedge)`,
Overall_macro = `Overall macro`,
Overall_micro = `Overall micro`
) %>%
mutate(
Donor_type = recode(Donor_type, "y" = "DCD", "n" = "DBD"),
Donor_type = factor(Donor_type, levels = c("DBD", "DCD")),
Right_lobe_biopsy_type = recode(Right_lobe_biopsy_type, "1" = "Core", "0" = "Wedge"),
Right_lobe_biopsy_type = factor(Right_lobe_biopsy_type, levels = c("Wedge", "Core")),
Left_lobe_biopsy_type = recode(Left_lobe_biopsy_type, "1" = "Core", "0" = "Wedge"),
Left_lobe_biopsy_type = factor(Left_lobe_biopsy_type, levels = c("Wedge", "Core"))
)
# Create merged dataset
df_combined <- USC_Liver_data %>%
left_join(OrQA_overall_scores, by = "USC Study ID") %>%
mutate(
OrQA_cat  = cut(OrQA_Score,
breaks = c(-Inf, 2, 3, Inf),
labels = c("None/Mild","Moderate","Severe")),
Macro_cat = cut(Overall_macro,
breaks = c(-Inf, 30, 60, Inf),
labels = c("None/Mild","Moderate","Severe")),
OrQA_bin  = factor(if_else(OrQA_Score < 2, "None/Mild", "Mod/Severe"),
levels = c("None/Mild","Mod/Severe")),
Macro_bin = factor(if_else(Overall_macro < 30, "None/Mild", "Mod/Severe"),
levels = c("None/Mild","Mod/Severe"))
)
## Linear regression
df_combined %>%
ggplot(aes(x = OrQA_Score, y = Overall_macro)) +
geom_point() +
geom_smooth(method = "lm", se = T) +
coord_cartesian(xlim = c(0, 4), ylim = c(0, 60)) +
labs(
x = "OrQA-L Score",
y = "Overall macro steatosis on biopsy",
title = "OrQA-L Score vs Overall macro steatosis on biopsy"
) +
theme_minimal()
## Non linear visualisation
df_combined %>%
ggplot(aes(x = OrQA_Score, y = Overall_macro)) +
geom_point() +
geom_smooth(method = "gam", se = T) +
coord_cartesian(xlim = c(0, 4), ylim = c(0, 60)) +
labs(
x     = "OrQA-L Score",
y     = "Overall macro steatosis on biopsy",
title = "OrQA-L Score vs Overall macro steatosis on biopsy"
) +
theme_minimal()
View(df_combined)
# non linear analysis using rms and rmsMD packages
dd <- datadist(df_combined)
options(datadist = "dd")
# Create a non linear model with rcs for ORQA-L
fit_non_lnear <- ols(Overall_macro ~ rcs(OrQA_Score, 3), data = df_combined,
x = TRUE, y = TRUE)
fit_non_lnear
modelsummary_rms(fit_non_lnear)
ggrmsMD(fit_non_lnear, df_combined,
ylim = c(0, 60),
xlims = list( "OrQA_Score" = c(0, 4)),
xlabs = list( "OrQA_Score" = "OrQA-L Score"),
ylab = "Overall macro steatosis on biopsy")
